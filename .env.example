# Kopieren nach .env und Werte eintragen:  cp .env.example .env
# Zufallswerte erzeugen:                   openssl rand -hex 32

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=stammbaum.beikolbs.de
DJANGO_CSRF_TRUSTED_ORIGINS=https://stammbaum.beikolbs.de

# Anmeldung über Authentik (Produktion)
AUTH_MODE=authentik
AUTHENTIK_ALLOWED_GROUPS=admin,familie
AUTHENTIK_ADMIN_GROUPS=admin

# Datenbank (PostgreSQL-Container "db")
DB_ENGINE=postgres
DB_NAME=familytree
DB_USER=familytree
DB_PASSWORD=
